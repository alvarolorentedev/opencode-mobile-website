---
// Site-wide search box + modal, powered by the same Pagefind index that
// Starlight builds. The Pagefind UI assets are lazy-loaded on first open.
---

<button
  class="site-nav__search"
  type="button"
  data-search-open
  aria-label="Search the site"
>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <circle cx="11" cy="11" r="6" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
    <path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
  </svg>
  <span>Search</span>
  <kbd>⌘K</kbd>
</button>

<dialog class="site-search-dialog" id="site-search-dialog" aria-label="Search">
  <div class="site-search-dialog__inner">
    <div class="site-search-dialog__bar">
      <span>Search OpenCode Mobile</span>
      <button
        class="site-search-dialog__close"
        id="site-search-close"
        type="button"
        aria-label="Close search"
      >
        ✕
      </button>
    </div>
    <div id="site-search-results" class="site-search-dialog__results"></div>
  </div>
</dialog>

<script is:inline>
  (() => {
    let loaded = false;
    let ui = null;

    const dialog = document.getElementById('site-search-dialog');

    const loadPagefind = () => {
      if (loaded) return Promise.resolve();
      loaded = true;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(link);
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = '/pagefind/pagefind-ui.js';
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    };

    const openSearch = () => {
      if (dialog && !dialog.open) dialog.showModal();
      loadPagefind()
        .then(() => {
          if (!ui && window.PagefindUI) {
            ui = new window.PagefindUI({
              element: '#site-search-results',
              showSubResults: true,
              showImages: false,
              resetStyles: false,
            });
          }
          document.querySelector('#site-search-results input')?.focus();
        })
        .catch(() => {
          const results = document.getElementById('site-search-results');
          if (results) {
            results.textContent =
              'Search is generated in the production build. Run `npm run build` and `npm run preview`.';
          }
        });
    };

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-search-open]');
      if (trigger) {
        event.preventDefault();
        openSearch();
      }
    });

    document
      .getElementById('site-search-close')
      ?.addEventListener('click', () => dialog?.close());

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        openSearch();
      }
    });
  })();
</script>
