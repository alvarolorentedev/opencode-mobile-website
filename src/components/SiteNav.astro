---
import SiteSearch from './SiteSearch.astro';
import ThemeSelect from './ThemeSelect.astro';
import { downloadLink, githubLink, navLinks } from '../lib/nav';
---

<nav class="site-nav" aria-label="Main">
  <div class="site-nav__inner">
    <a class="site-nav__brand" href="/">
      <img src="/img/logo.svg" alt="" width="28" height="28" />
      <span>OpenCode Mobile</span>
    </a>

    <div class="site-nav__menu" id="site-menu">
      <button class="site-nav__menu-search" type="button" data-search-open>
        Search
      </button>

      <ul class="site-nav__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>

      <SiteSearch />

      <a
        class="site-nav__github"
        href={githubLink.href}
        rel="noopener noreferrer"
        aria-label={githubLink.label}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
          ></path>
        </svg>
      </a>

      <a class="site-nav__cta" href={downloadLink.href}>{downloadLink.label}</a>

      <div class="site-nav__menu-theme">
        <ThemeSelect />
      </div>
    </div>

    <div class="site-nav__end">
      <ThemeSelect />

      <button
        class="site-nav__burger"
        id="site-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Open main menu"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  (() => {
    const toggle = document.getElementById('site-menu-toggle');
    const menu = document.getElementById('site-menu');

    const closeMenu = () => {
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open main menu');
    };

    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open main menu' : 'Close main menu');
      menu?.classList.toggle('is-open', !open);
    });

    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu?.classList.contains('is-open')) {
        closeMenu();
      }
    });

    const root = document.documentElement;
    const themeSelects = document.querySelectorAll('[data-theme-select]');

    const applyTheme = (value) => {
      try {
        if (value === 'auto') localStorage.removeItem('starlight-theme');
        else localStorage.setItem('starlight-theme', value);
      } catch {}
      root.dataset.theme =
        value === 'auto'
          ? window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark'
          : value;
    };

    let stored = 'auto';
    try {
      stored = localStorage.getItem('starlight-theme') || 'auto';
    } catch {}

    themeSelects.forEach((select) => {
      select.value = stored;
      select.addEventListener('change', () => {
        applyTheme(select.value);
        themeSelects.forEach((other) => {
          other.value = select.value;
        });
      });
    });
  })();
</script>
